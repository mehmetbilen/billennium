@page "/initialize"


<!-- Page Header -->
<section class="hero fade-in" style="padding-bottom: 1rem;">
    <div class="terminal-status">> EXECUTING: /initialize_contact</div>
    <h1 class="main-heading">Establish <strong>Connection.</strong></h1>
    <p class="sub-heading">
        Ready to scale your architecture? Open a direct communication channel to discuss technical requirements, cloud infrastructure, or system integration.
    </p>
</section>

<!-- Secure Contact Terminal -->
<section class="fade-in delay-1">
    <div class="contact-terminal">

        <div class="contact-row">
            <span class="contact-label">> COMMUNICATION_PROTOCOL</span>
            <span class="contact-data">Direct Email Exchange</span>
        </div>

        <div class="contact-row">
            <span class="contact-label">> PRIMARY_ADDRESS</span>
            <span class="contact-data">
                <a href="mailto:hello@billenniumtechnology.com" class="email-link">hello@billenniumtechnology.com</a>
            </span>
        </div>

        <div class="contact-row">
            <span class="contact-label">> RESPONSE_SLA</span>
            <span class="contact-data" style="color: var(--text-muted); font-size: 1rem;">
                Standard queries are typically processed within 24 hours.
            </span>
        </div>

    </div>

    <NavLink href="" Match="NavLinkMatch.All" class="term-link">> RETURN_TO_ROOT</NavLink>
</section>
